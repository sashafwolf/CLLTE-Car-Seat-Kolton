# CLLTE Car Seat — copy this file to .env and fill in real values.
# Never commit .env. These are the keys Kolton's local machine needs.

# --- Voice (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=koltons_collette_voice_id
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- Prediction (OpenRouter / Luna) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Optional: Gemini fallback ---
GEMINI_API_KEY=

# --- Tuning ---
CARSEAT_HOST=127.0.0.1
CARSEAT_PORT=8001
CARSEAT_STT_MODEL=medium
CARSEAT_STT_DEVICE=cuda
CARSEAT_STT_COMPUTE=float16
CARSEAT_CHUNK_EVERY=3
CARSEAT_GRACE_SECONDS=2.0
CARSEAT_AUTO_SLEEP_SECONDS=180.0
CARSEAT_MAX_PREDICT_WORDS=5
CARSEAT_VOLUME_HIGH=3000
CARSEAT_VOLUME_LOW=1500

